---
import { playlist } from '@/components/MusicPlayList.js'
const STORAGE_KEY = 'music-player-state'
---

<iframe
  id="music-frame"
  src="/music/player-frame.html"
  style="display:none;border:none;"
  allow="autoplay"
></iframe>

<div id="music-player-panel" class="music-panel" aria-hidden="true" inert>
  <div class="mp-track-info">
    <img id="mp-cover" class="mp-cover" src="" alt="cover of the current song" />
    <div class="mp-meta">
      <div id="mp-title" class="mp-song-title">—</div>
      <div id="mp-artist" class="mp-song-artist">—</div>
    </div>
  </div>

  <div class="mp-progress-row">
    <span id="mp-cur" class="mp-time">0:00</span>
    <div id="mp-bar" class="mp-bar">
      <div id="mp-fill" class="mp-fill"></div>
      <div id="mp-thumb" class="mp-thumb"></div>
    </div>
    <span id="mp-dur" class="mp-time">0:00</span>
  </div>

  <div class="mp-controls">
    <button id="mp-mode" class="mp-btn-sm" aria-label="Play mode" title="List repeat">
      <svg id="mp-mode-list" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="17 1 21 5 17 9"/>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
        <polyline points="7 23 3 19 7 15"/>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
      </svg>
      <svg id="mp-mode-single" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        style="display:none">
        <polyline points="17 1 21 5 17 9"/>
        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
        <polyline points="7 23 3 19 7 15"/>
        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        <text x="12" y="14" text-anchor="middle" font-size="8" fill="currentColor"
          stroke="none" font-weight="bold">1</text>
      </svg>
      <svg id="mp-mode-shuffle" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        style="display:none">
        <polyline points="16 3 21 3 21 8"/>
        <line x1="4" y1="20" x2="21" y2="3"/>
        <polyline points="21 16 21 21 16 21"/>
        <line x1="15" y1="15" x2="21" y2="21"/>
        <line x1="4" y1="4" x2="9" y2="9"/>
      </svg>
    </button>

    <button id="mp-prev" class="mp-btn-sm" aria-label="Previous">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
      </svg>
    </button>

    <button id="mp-play" class="mp-btn-play" aria-label="Play/Pause">
      <svg id="mp-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="6 3 20 12 6 21 6 3"/>
      </svg>
      <svg id="mp-icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
        style="display:none">
        <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
      </svg>
    </button>

    <button id="mp-next" class="mp-btn-sm" aria-label="Next">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
      </svg>
    </button>

    <button id="mp-list-btn" class="mp-btn-sm" aria-label="Playlist">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <circle cx="3" cy="6" r="1" fill="currentColor"/>
        <circle cx="3" cy="12" r="1" fill="currentColor"/>
        <circle cx="3" cy="18" r="1" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <div class="mp-vol-row">
    <button id="mp-vol-icon" class="mp-btn-sm" aria-label="Volume">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73
          2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5
          6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
      </svg>
    </button>
    <div id="mp-vol-bar" class="mp-vol-bar">
      <div id="mp-vol-fill" class="mp-vol-fill"></div>
    </div>
  </div>

  <div id="mp-playlist" class="mp-playlist" aria-hidden="true" inert></div>
</div>

<script is:inline define:vars={{ playlist, STORAGE_KEY }}>
;(function () {
  'use strict'

  const $ = (id) => document.getElementById(id)
  const frame      = $('music-frame')
  const panel      = $('music-player-panel')
  const elTitle    = $('mp-title')
  const elCover    = $('mp-cover')
  const elArtist   = $('mp-artist')
  const elCur      = $('mp-cur')
  const elDur      = $('mp-dur')
  const elBar      = $('mp-bar')
  const elFill     = $('mp-fill')
  const elThumb    = $('mp-thumb')
  const elPlay     = $('mp-icon-play')
  const elPause    = $('mp-icon-pause')
  const elVolFill  = $('mp-vol-fill')
  const elPlaylist = $('mp-playlist')
  const elModeList = $('mp-mode-list')
  const elModeSingle = $('mp-mode-single')
  const elModeShuffle = $('mp-mode-shuffle')
  const elModeBtn  = $('mp-mode')

  let currentIndex = 0
  let isPlaying    = false
  let currentTime  = 0
  let duration     = 0
  let volume       = 0.1
  let playMode     = 'list'
  let audioReady   = false
  let playlistOpen = false
  let dragging     = false

  //  iframe 通信（直接调用同源 iframe 内的函数，保留用户手势）
  function send(action, data) {
    var win = frame.contentWindow
    if (!win || !win.MusicFrame) return
    try {
      switch (action) {
        case 'init': win.MusicFrame.init(); break
        case 'play': win.MusicFrame.play(data.src, data.currentTime); break
        case 'pause': win.MusicFrame.pause(); break
        case 'seek': win.MusicFrame.seek(data.currentTime); break
        case 'setVolume': win.MusicFrame.setVolume(data.volume); break
        case 'load': win.MusicFrame.load(data.src); break
        case 'getState': win.MusicFrame.getState(); break
      }
    } catch (e) { console.error('[MusicPlayer] send error:', e) }
  }

  // 接收 iframe 的状态上报（异步 postMessage 是安全的）
  window.addEventListener('message', function (e) {
    var d = e.data
    if (!d || d.source !== 'music-frame') return
    onFrameMsg(d)
  })

  function onFrameMsg(msg) {
    switch (msg.type) {
      case 'ready':
        audioReady = true
        var wasPlaying = false
        if (msg.restored) {
          try {
            var raw = sessionStorage.getItem(STORAGE_KEY)
            if (raw) {
              var s = JSON.parse(raw)
              if (s.playMode) playMode = s.playMode
              if (typeof s.volume === 'number') volume = s.volume
              if (typeof s.currentIndex === 'number') currentIndex = s.currentIndex
              if (typeof s.duration === 'number') duration = s.duration
              if (typeof s.currentTime === 'number') currentTime = s.currentTime
              if (typeof s.isPlaying === 'boolean') wasPlaying = s.isPlaying
            }
          } catch (_) {}

          if (wasPlaying) {
            var track = playlist[currentIndex]
            if (track) {
              send('play', { src: track.src, currentTime: currentTime })
            }
          } 
        } {/* else {
            send('load', { src: playlist[0].src })
          } */}
        refreshUI()
        break
      case 'playing':
        isPlaying = true
        patchStorage({ isPlaying: true })
        refreshUI()
        break
      case 'paused':
        isPlaying = false
        patchStorage({ isPlaying: false })
        refreshUI()
        break
      case 'timeupdate':
        currentTime = msg.currentTime || 0
        if (msg.duration && isFinite(msg.duration)) duration = msg.duration
        updateProgress()
        break
      case 'loaded':
        if (msg.duration && isFinite(msg.duration)) {
          duration = msg.duration
          updateProgress()
        }
        break
      case 'ended':
        handleTrackEnded()
        break
      case 'state':
        currentTime = msg.currentTime || 0
        duration = msg.duration || duration
        isPlaying = msg.isPlaying || false
        refreshUI()
        break
      case 'play-error':
        console.warn('[MusicPlayer] play error:', msg.message)
        break
    }
  }

  frame.addEventListener('load', function () {
    audioReady = false
    setTimeout(function () { send('init') }, 30)
  })

  //  播放控制
  function loadAndPlay(index, resumeTime) {
    if (index < 0) index = playlist.length - 1
    if (index >= playlist.length) index = 0
    currentIndex = index
    var track = playlist[currentIndex]
    var t = typeof resumeTime === 'number' ? resumeTime : 0

    updateTrackInfo(track)
    renderPlaylist()

    if (audioReady) {
      send('play', { src: track.src, currentTime: t })
    }
    patchStorage({ currentIndex: currentIndex })
  }

  function togglePlay() {
    if (isPlaying) {
      send('pause')
    } else {
      if (audioReady) {
        send('play', {
          src: playlist[currentIndex].src,
          currentTime: currentTime > 0 ? currentTime : 0
        })
      }
    }
  }

  function playNext() { loadAndPlay(getNextIndex()) }

  function playPrev() {
    if (currentTime > 3) {
      send('seek', { currentTime: 0 })
      currentTime = 0
      updateProgress()
    } else {
      loadAndPlay((currentIndex - 1 + playlist.length) % playlist.length)
    }
  }

  function getNextIndex() {
    switch (playMode) {
      case 'single': return currentIndex
      case 'shuffle':
        if (playlist.length <= 1) return 0
        var next
        do { next = Math.floor(Math.random() * playlist.length) } while (next === currentIndex)
        return next
      case 'list':
      default:
        return (currentIndex + 1) % playlist.length
    }
  }

  function handleTrackEnded() {
    isPlaying = false
    currentTime = 0
    if (playMode === 'single') {
      loadAndPlay(currentIndex, 0)
    } else {
      loadAndPlay(getNextIndex(), 0)
    }
  }

  function cycleMode() {
    var modes = ['list', 'single', 'shuffle']
    var i = modes.indexOf(playMode)
    playMode = modes[(i + 1) % modes.length]
    updateModeIcon()
    patchStorage({ playMode: playMode })
  }

  //  UI 更新
  function refreshUI() {
    updatePlayBtn()
    updateTrackInfo(playlist[currentIndex])
    updateProgress()
    updateModeIcon()
    updateTrigger()
    renderPlaylist()
  }

  function updatePlayBtn() {
    elPlay.style.display  = isPlaying ? 'none' : 'block'
    elPause.style.display = isPlaying ? 'block' : 'none'
  }

  function updateTrackInfo(track) {
    if (!track) return
    elTitle.textContent  = track.title  || '—'
    elArtist.textContent = track.artist || '—'
    if (track.cover) {
      elCover.dataset.src = track.cover
      elCover.style.display = 'block'
      if (panel.classList.contains('open')) {
        elCover.src = track.cover
      }
    } else {
      elCover.style.display = 'none'
      elCover.removeAttribute('src')
      delete elCover.dataset.src
    }
  }

  function fmtTime(sec) {
    if (!sec || !isFinite(sec)) return '0:00'
    var m = Math.floor(sec / 60)
    var s = Math.floor(sec % 60)
    return m + ':' + String(s).padStart(2, '0')
  }

  function updateProgress() {
    var pct = duration > 0 ? (currentTime / duration) * 100 : 0
    elFill.style.width  = pct + '%'
    elThumb.style.left  = pct + '%'
    elCur.textContent   = fmtTime(currentTime)
    elDur.textContent   = fmtTime(duration)
  }

  function updateModeIcon() {
    elModeList.style.display    = playMode === 'list'    ? 'block' : 'none'
    elModeSingle.style.display  = playMode === 'single'  ? 'block' : 'none'
    elModeShuffle.style.display = playMode === 'shuffle' ? 'block' : 'none'
    var titles = { list: 'List repeat', single: 'Single repeat', shuffle: 'Shuffle' }
    elModeBtn.title = titles[playMode] || ''
  }

  function updateTrigger() {
    var btn = document.getElementById('music-trigger')
    if (!btn) return
    btn.classList.toggle('is-playing', isPlaying)
  }

  // ─── 播放列表渲染 ───
  function renderPlaylist() {
    var html = ''
    for (var i = 0; i < playlist.length; i++) {
      var t = playlist[i]
      var active = i === currentIndex
      var isCurrentlyPlaying = active && isPlaying
      html += '<button class="mp-pl-item' + (active ? ' active' : '') + '" data-idx="' + i + '">'
      html += '<span class="mp-pl-num">' + (i + 1) + '</span>'
      html += '<span class="mp-pl-title">' + escHtml(t.title) + '</span>'
      if ( isCurrentlyPlaying ) {
        html += '<span class="mp-pl-bars" aria-hidden="true">'
        html += '<span></span><span></span><span></span>'
        html += '</span>'
      } 

      html += '</button>'
    }
    elPlaylist.innerHTML = html

    var items = elPlaylist.querySelectorAll('.mp-pl-item')
    for (var j = 0; j < items.length; j++) {
      items[j].addEventListener('click', function () {
        var idx = parseInt(this.getAttribute('data-idx'), 10)
        loadAndPlay(idx)
      })
    }
  }

  function escHtml(s) {
    var d = document.createElement('div')
    d.textContent = s
    return d.innerHTML
  }

  //  面板开关
  function openPanel() {
    panel.classList.add('open')
    panel.removeAttribute('inert')
    panel.setAttribute('aria-hidden', 'false')
    if (elCover.dataset.src) {
      elCover.src = elCover.dataset.src
    }
    if (audioReady) send('getState')
  }

  function closePanel() {
    panel.classList.remove('open')
    panel.setAttribute('inert', '')
    panel.setAttribute('aria-hidden', 'true')
    playlistOpen = false
    elPlaylist.classList.remove('open')
    elPlaylist.setAttribute('aria-hidden', 'true')
    elPlaylist.setAttribute('inert', '')
  }

  function togglePlaylist() {
    playlistOpen = !playlistOpen
    elPlaylist.classList.toggle('open', playlistOpen)
    elPlaylist.setAttribute('aria-hidden', String(!playlistOpen))
    if (playlistOpen) {
      elPlaylist.removeAttribute('inert')
    } else {
      elPlaylist.setAttribute('inert', '')
    }
  }

  window.__musicPlayer = { openPanel: openPanel, closePanel: closePanel }

  //  事件绑定
  $('mp-play').addEventListener('click', togglePlay)
  $('mp-prev').addEventListener('click', playPrev)
  $('mp-next').addEventListener('click', playNext)
  elModeBtn.addEventListener('click', cycleMode)
  $('mp-list-btn').addEventListener('click', togglePlaylist)

  function seekFromEvent(e) {
    var rect = elBar.getBoundingClientRect()
    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width))
    var t = pct * duration
    send('seek', { currentTime: t })
    currentTime = t
    updateProgress()
  }

  elBar.addEventListener('mousedown', function (e) { dragging = true; seekFromEvent(e) })
  document.addEventListener('mousemove', function (e) { if (dragging) seekFromEvent(e) })
  document.addEventListener('mouseup', function () { dragging = false })
  elBar.addEventListener('touchstart', function (e) { dragging = true; seekFromEvent(e.touches[0]) }, { passive: true })
  document.addEventListener('touchmove', function (e) { if (dragging) seekFromEvent(e.touches[0]) }, { passive: true })
  document.addEventListener('touchend', function () { dragging = false })

  $('mp-vol-bar').addEventListener('click', function (e) {
    var rect = this.getBoundingClientRect()
    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width))
    volume = pct
    elVolFill.style.width = (pct * 100) + '%'
    send('setVolume', { volume: pct })
    patchStorage({ volume: pct })
  })

  document.addEventListener('click', function (e) {
    if (!panel.classList.contains('open')) return
    var trigger = document.getElementById('music-trigger')
    if (panel.contains(e.target) || (trigger && trigger.contains(e.target))) return
    closePanel()
  })

  document.addEventListener('keydown', function (e) {
    if (!panel.classList.contains('open')) return
    switch (e.key) {
      case ' ': e.preventDefault(); togglePlay(); break
      case 'ArrowRight': send('seek', { currentTime: Math.min(duration, currentTime + 5) }); break
      case 'ArrowLeft': send('seek', { currentTime: Math.max(0, currentTime - 5) }); break
      case 'Escape': closePanel(); break
    }
  })

  function patchStorage(data) {
    try {
      var cur = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '{}')
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ ...cur, ...data }))
    } catch (_) {}
  }

  elVolFill.style.width = (volume * 100) + '%'
  send('setVolume', { volume: volume })
  renderPlaylist()
  updateTrackInfo(playlist[0])

  window.addEventListener('beforeunload', function () {
    send('getState')
  })
})()
</script>

<style>
  .music-panel {
    position: fixed;
    bottom: 3.5rem;
    right: 1rem;
    width: 320px;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    background: hsl(var(--background) / 0.97);
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    box-shadow: 0 8px 32px hsl(var(--foreground) / 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1rem;
    z-index: 50;
    opacity: 0;
    transform: translateY(12px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    color: hsl(var(--foreground));
  }
  .music-panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .mp-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: hsl(var(--muted-foreground));
  }
  .mp-track-info {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .mp-cover {
    width: 48px;
    height: 48px;
    border-radius: 0.5rem;
    object-fit: cover;
    background: hsl(var(--muted));
    flex-shrink: 0;
  }
  .mp-meta { overflow: hidden; min-width: 0; width: 100%; }
  .mp-song-title {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: hsl(var(--foreground));
    text-align: center;
  }
  .mp-song-artist {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    margin-top: 2px;
    text-align: center;
  }
  .mp-progress-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .mp-time {
    font-size: 0.625rem;
    color: hsl(var(--muted-foreground));
    min-width: 2rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .mp-bar {
    flex: 1;
    height: 4px;
    background: hsl(var(--muted));
    border-radius: 999px;
    position: relative;
    cursor: pointer;
    transition: height 0.15s;
  }
  .mp-bar:hover { height: 6px; }
  .mp-fill {
    height: 100%;
    background: hsl(var(--primary));
    border-radius: 999px;
    width: 0%;
    pointer-events: none;
  }
  .mp-thumb {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 12px;
    height: 12px;
    background: hsl(var(--primary));
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .mp-bar:hover .mp-thumb { opacity: 1; }
  .mp-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .mp-btn-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: hsl(var(--foreground));
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    padding: 0;
    flex-shrink: 0;
  }
  .mp-btn-sm:hover {
    background: hsl(var(--muted));
    color: hsl(var(--primary));
  }
  .mp-btn-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground, var(--background)));
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.15s, opacity 0.15s;
    padding: 0;
    flex-shrink: 0;
  }
  .mp-btn-play:hover {
    transform: scale(1.08);
    opacity: 0.9;
  }
  .mp-vol-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .mp-vol-bar {
    flex: 1;
    height: 4px;
    background: hsl(var(--muted));
    border-radius: 999px;
    cursor: pointer;
    position: relative;
  }
  .mp-vol-fill {
    height: 100%;
    background: hsl(var(--primary));
    border-radius: 999px;
    width: 70%;
    transition: width 0.1s;
  }
  /* 播放列表 */
  .mp-playlist {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, margin-top 0.3s ease;
    margin-top: 0;
  }
  .mp-playlist.open {
    max-height: 300px;
    overflow-y: auto;
    margin-top: 0.75rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
  }
  :global(.mp-pl-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.5rem;
    margin-bottom: 0.25rem;
    border: none;
    background: transparent;
    color: hsl(var(--foreground));
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.15s;
    text-align: left;
    box-sizing: border-box;
  }
  :global(.mp-pl-item:hover) { background: hsl(var(--muted)); }
  :global(.mp-pl-item.active) { 
    background: hsl(var(--primary) / 0.12); 
  }
